APP_NAME=Clipper-MS
APP_ENV=local
APP_KEY=base64:5G33hqnJVbMIGZsrWEZKW8aN2fMO1QVbRvUjJU90AIg=
APP_DEBUG=true
APP_URL=http://clipper-laravel.test

# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default local development profile: Herd + SQLite + local filesystem
FILESYSTEM_DISK=public
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync


CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.nl"
MAIL_FROM_NAME="Example"

VITE_APP_NAME="${APP_NAME}"

# Optional: only needed for the local Gemini RAG helper scripts
GOOGLE_API_KEY=

# Optional: switch MAIL_MAILER to resend in environments that should send real mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.nl
NOTIFICATION_EMAIL=example@example.nl

# Docker local / production profile values live in .env.local and .env.production
