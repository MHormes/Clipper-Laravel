APP_NAME=app_name
APP_ENV=local
APP_KEY=base64:5G33hqnJVbMIGZsrWEZKW8aN2fMO1QVbRvUjJU90AIg=
APP_DEBUG=true
APP_URL=http://testurl.com

# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# # Local POSTGRESQL
DB_CONNECTION=pgsql
DB_HOST=postgres_host
DB_PORT=5432
DB_DATABASE=db_name
DB_USERNAME=db_username
DB_PASSWORD=db_password
DB_SSLMODE=disable

CLOUDFLARE_TUNNEL_TOKEN=eyrandomlongasstokentoinsertinhere

# Local Blob
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=access_key
AWS_SECRET_ACCESS_KEY=secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=bucket_nane
AWS_URL=http://s3url.com/bucketname
AWS_ENDPOINT=http://s3url.com
AWS_USE_PATH_STYLE_ENDPOINT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database


CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"